# คัดลอกไฟล์นี้เป็น keystore.properties แล้วกรอกข้อมูลจริง
# (keystore.properties จะไม่ถูก commit ขึ้น git)

# พาธไปยังไฟล์ keystore — ใช้ / แทน \ (เช่น C:/Users/User/keys/upload.jks)
storeFile=C:/path/to/your/upload-key.jks

# รหัสผ่านของ keystore
storePassword=YOUR_STORE_PASSWORD

# ชื่อ alias ของ key
keyAlias=YOUR_KEY_ALIAS

# รหัสผ่านของ key (มักเหมือน storePassword)
keyPassword=YOUR_KEY_PASSWORD
